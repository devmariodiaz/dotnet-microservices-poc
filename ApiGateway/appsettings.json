{
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "basket": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/basket" } ]
      },
      "ordering": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/ordering/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/ordering" } ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalog.api/"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket": {
            "Address": "http://basket.api/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering": {
            "Address": "http://ordering.api/"
          }
        }
      }
    }
  }
}
